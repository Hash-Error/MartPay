datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id           String     @id @default(uuid())
  username     String     @unique
  passwordHash String
  role         String     @default("customer") // "customer" | "gate_staff" | "admin"
  createdAt    DateTime   @default(now())
  orders       Order[]
  auditLogs    AuditLog[]

  @@map("users")
}

model Product {
  id          String   @id @default(uuid())
  barcode     String   @unique
  name        String
  price       Float
  stock       Int
  description String?
  createdAt   DateTime @default(now())

  @@map("products")
}

model Order {
  id          String    @id @default(uuid())
  userId      String
  items       Json      // Serialized product items: [{ barcode, quantity, price, name }]
  totalAmount Float
  status      String    @default("pending") // "pending" | "paid" | "completed_exit"
  qrToken     String?
  qrExpiresAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("orders")
}

model AuditLog {
  id        String   @id @default(uuid())
  eventType String   // e.g. "AUTH_FAILED", "QR_VERIFIED_SUCCESS", "QR_REJECTED_DUPLICATE"
  message   String
  timestamp DateTime @default(now())
  userId    String?
  details   Json?

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@map("audit_logs")
}
